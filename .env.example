# Copia este archivo a .env y rellena los valores. El .env NUNCA se sube a git
# (ya está en .gitignore) — si algún valor de aquí abajo acaba en un commit,
# considéralo filtrado y regenera esa clave desde el dashboard de Supabase/Stripe.

# --- Supabase (ver docs/6-SUPABASE-SETUP.md) ---------------------------------
# Panel del proyecto > Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Secreta. Salta todas las reglas de seguridad (RLS) — solo se usa en scripts
# locales o en el servidor, JAMÁS en código que llegue al navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional y secreta. Conexión directa a Postgres, solo para scripts locales
# (scripts/apply-pending-migrations.mjs). El host directo `db.<ref>.supabase.co`
# solo tiene IPv6: sin IPv6 en tu red usa la cadena del "Session pooler"
# (Panel > Connect), que funciona por IPv4.
SUPABASE_DB_URL=

# --- Stripe (Fase 3, todavía no hace falta) ----------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Sugerencias de IA (Fase 4, ver docs/8-AI-SUGGESTIONS-SETUP.md) ----------
# Modelo GRATUITO vía OpenRouter (cuenta gratis en https://openrouter.ai, la
# key se genera en https://openrouter.ai/keys). Si falta, /api/ml/predict
# sigue funcionando igual, solo que sin enriquecer con IA (cae en el texto
# fijo de siempre) — no es obligatoria para que la app arranque.
OPENROUTER_API_KEY=
# Si este modelo deja de estar disponible gratis, cambia por otro de
# https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# --- Script de usuarios de prueba (opcional) ---------------------------------
# Contraseña compartida de las cuentas demo (seeds y tests de integración). Sin valor
# en este archivo: pon la tuya en .env (nunca en el repositorio).
DEMO_PASSWORD=

# --- OAuth real de Instagram (Fase 4, ver docs/9-INSTAGRAM-OAUTH-SETUP.md) --
# App creada en developers.facebook.com > Instagram > API setup with
# Instagram login. Sin esto, "Conectar" en Redes da un error claro en vez de
# un flujo roto — no es obligatorio para que el resto de la app arranque.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback
# Meta NO acepta http://localhost como redirect URI: hace falta una URL HTTPS
# (p. ej. un túnel de ngrok) tanto en INSTAGRAM_REDIRECT_URI como en el panel
# de Meta. Con túnel, define APP_URL=http://localhost:3000 para que, tras
# conectar, el callback te devuelva a tu app local (donde tienes la sesión).
APP_URL=

# --- OAuth real de YouTube (Fase 4, ver docs/10-YOUTUBE-OAUTH-SETUP.md) -----
# Proyecto creado en console.cloud.google.com con la "YouTube Data API v3"
# habilitada y un "OAuth client ID" de tipo "Web application". Sin esto,
# "Conectar" en Redes da un error claro en vez de un flujo roto.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# 32 bytes en base64 — genera la tuya con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Cifra los tokens de redes sociales en la base de datos. Si la cambias, las
# cuentas ya conectadas dejan de poder descifrarse y hay que reconectarlas.
SOCIAL_TOKEN_ENCRYPTION_KEY=

# --- Sincronización programada de redes (POST /api/social/sync-all) --------
# Secreto compartido con quien lance la sincronización (cron del host, pg_cron,
# GitHub Actions...). Se envía como "Authorization: Bearer <secreto>". Sin él, el
# endpoint responde 503 y no hace nada. Genera el tuyo con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SYNC_CRON_SECRET=

# --- Panel de administración (/admin) ----------------------------------------
# Contraseña única compartida por el equipo — nunca una cuenta de Supabase.
# Ponle algo largo y random, no una frase que se adivine. Genera una con:
# node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_PASSWORD=
# Solo cifra la cookie de sesión del panel una vez ya has entrado con la
# contraseña de arriba — no es la contraseña en sí, no hace falta que la
# recuerdes. Mínimo 32 caracteres. Genera una con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# --- Monitorización de errores (Sentry, plan gratuito) ------------------------
# DSN del proyecto de Sentry. Vacío = Sentry desactivado (no se envía nada).
SENTRY_DSN=
# Nombre del entorno que verás en Sentry: development | staging | production
APP_ENV=

# Inicio de sesión con Google (opcional). Ponlo a `true` SOLO después de activar el
# proveedor Google en Supabase (Authentication → Providers) con el client id y el secreto
# de Google Cloud. Pasos en docs/13-INTEGRACIONES-PENDIENTES.md.
GOOGLE_AUTH_ENABLED=

# --- Lanzamiento gratis / cobros ---------------------------------------------
# APAGADO por defecto (vacío o cualquier valor que no sea "true"): CIBERAN no cobra.
# La interfaz no enseña Pro, «Pagar», comisión ni cuenta de cobro, y los endpoints
# /api/stripe/* que abren pagos responden 403 aunque las claves de Stripe estén puestas.
# Ponlo en "true" SOLO cuando se decida empezar a cobrar (ver docs/7-STRIPE-SETUP.md
# y docs/13-INTEGRACIONES-PENDIENTES.md).
PAYMENTS_ENABLED=

# Predicción de éxito (IA). APAGADA por defecto: oculta en la interfaz y /api/ml/predict responde 403,
# para no gastar llamadas de IA en una función que aún no es fiable. "true" la recupera tal cual.
PREDICTIONS_ENABLED=
