# Copia este archivo a .env y rellena los valores. El .env NUNCA se sube a git
# (ya está en .gitignore) — si algún valor de aquí abajo acaba en un commit,
# considéralo filtrado y regenera esa clave desde el dashboard de Supabase/Stripe.

# --- Supabase (ver docs/6-SUPABASE-SETUP.md) ---------------------------------
# Panel del proyecto > Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Secreta. Salta todas las reglas de seguridad (RLS) — solo se usa en scripts
# locales o en el servidor, JAMÁS en código que llegue al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Fase 3, todavía no hace falta) ----------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Sugerencias de IA (Fase 4, ver docs/8-AI-SUGGESTIONS-SETUP.md) ----------
# Modelo GRATUITO vía OpenRouter (cuenta gratis en https://openrouter.ai, la
# key se genera en https://openrouter.ai/keys). Si falta, /api/ml/predict
# sigue funcionando igual, solo que sin enriquecer con IA (cae en el texto
# fijo de siempre) — no es obligatoria para que la app arranque.
OPENROUTER_API_KEY=
# Si este modelo deja de estar disponible gratis, cambia por otro de
# https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Script de usuarios de prueba (opcional) ---------------------------------
# Contraseña compartida de las 3 cuentas demo que crea `npm run db:seed-users`.
DEMO_PASSWORD=feedma-demo-2026

# --- OAuth real de Instagram (Fase 4, ver docs/9-INSTAGRAM-OAUTH-SETUP.md) --
# App creada en developers.facebook.com > Instagram > API setup with
# Instagram login. Sin esto, "Conectar" en Redes da un error claro en vez de
# un flujo roto — no es obligatorio para que el resto de la app arranque.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback
# 32 bytes en base64 — genera la tuya con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Cifra los tokens de redes sociales en la base de datos. Si la cambias, las
# cuentas ya conectadas dejan de poder descifrarse y hay que reconectarlas.
SOCIAL_TOKEN_ENCRYPTION_KEY=
