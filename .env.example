# Copia este archivo a .env y rellena los valores. El .env NUNCA se sube a git
# (ya está en .gitignore) — si algún valor de aquí abajo acaba en un commit,
# considéralo filtrado y regenera esa clave desde el dashboard de Supabase/Stripe.

# --- Supabase (ver docs/6-SUPABASE-SETUP.md) ---------------------------------
# Panel del proyecto > Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Secreta. Salta todas las reglas de seguridad (RLS) — solo se usa en scripts
# locales o en el servidor, JAMÁS en código que llegue al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Fase 3, todavía no hace falta) ----------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Script de usuarios de prueba (opcional) ---------------------------------
# Contraseña compartida de las 3 cuentas demo que crea `npm run db:seed-users`.
DEMO_PASSWORD=feedma-demo-2026
